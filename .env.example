# Supabase (opțional — Faza 5). Fără aceste chei, Signa e 100% offline.

# Din dashboard: Project Settings → API
#  - Project URL  → VITE_SUPABASE_URL
#  - anon public  → VITE_SUPABASE_ANON_KEY
# Copiază acest fișier în .env.local (gitignored). Nu commita cheile.
# NU pune service_role aici — e secret de server, nu de frontend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Login cu Google/Apple (opțional). Butoanele apar doar dacă e "true" ȘI
# providerul e activat în Supabase Dashboard → Authentication → Providers.
# Vezi docs/supabase-setup.md.
VITE_ENABLE_OAUTH=false
